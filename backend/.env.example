# LifeFlow Backend Configuration
PROJECT_NAME="LifeFlow AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="lifeflow-secret-jwt-key-replace-in-production-with-random-hex"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database (Default: SQLite local db)
DATABASE_URL="sqlite:///./lifeflow.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# LLM & Hugging Face Configuration
# Set to "Qwen/Qwen3-8B" or "Qwen/Qwen2.5-7B-Instruct"
LLM_MODEL_NAME="Qwen/Qwen3-8B"
# Create a read-only token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_your_token_here"
USE_LOCAL_TRANSFORMERS=false
DEVICE="auto"
MAX_NEW_TOKENS=512
TEMPERATURE=0.7

# RAG Configuration
RAG_TOP_K=3
